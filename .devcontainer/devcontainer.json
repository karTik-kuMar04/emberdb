{
  "name": "emberdb",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "ubuntu",
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "forwardPorts": [6380],
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
