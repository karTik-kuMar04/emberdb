        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "emberdb_memory_used_bytes{instance=~\"$instance\"}",
          "legendFormat": "used {{instance}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "emberdb_memory_limit_bytes{instance=~\"$instance\"} > 0",
          "legendFormat": "limit {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Expired and evicted keys per second",
